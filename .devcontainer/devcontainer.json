{
  "name": "py-django-quiz-backend",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "service": "backend",
  "workspaceFolder": "/workspaces/py-django-quiz",
  "runServices": [
    "db",
    "backend",
    "frontend"
  ],
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "/workspaces/py-django-quiz/backend"
        ]
      }
    }
  }
}
